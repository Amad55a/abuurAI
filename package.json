{
  "name": "abuur-ai",
  "version": "0.2.0",
  "description": "A Somali-first JavaScript AI SDK for Gemini, OpenAI, Anthropic, Mistral, DeepSeek, Cohere, and xAI. Works in Node.js and the browser.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amad55a/somali-ai-connect.git"
  },
  "homepage": "https://github.com/Amad55a/somali-ai-connect#readme",
  "bugs": {
    "url": "https://github.com/Amad55a/somali-ai-connect/issues"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "browser": "./src/browser.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "browser": "./src/browser.js",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/index.d.ts",
      "import": "./src/browser.js",
      "default": "./src/browser.js"
    }
  },
  "files": [
    "README.md",
    "README.so.md",
    "ADVANCED.md",
    "SECURITY.md",
    "src",
    "assets"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "somali",
    "ai",
    "javascript",
    "sdk",
    "abuur-ai",
    "gemini",
    "openai",
    "anthropic",
    "mistral",
    "deepseek",
    "cohere",
    "xai"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "openai": "^7.47.0"
  },
  "devDependencies": {
    "dotenv": "^18.0.9"
  }
}
